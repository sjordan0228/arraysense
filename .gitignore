# Local working notes and task briefs — not part of the published project.
docs/roadmap.md
docs/design.md
NOTES.md
# Scratch working space: drafts, trial stylesheets, transcripts. It was ignored
# in .git/info/exclude, which lives in one clone and travels nowhere — so a
# fresh clone or a worktree saw the whole of it as untracked, one `git add -A`
# from being published. The .venv symlink further down reached the history by
# exactly that route, which is why this belongs in the tracked file instead.
.superpowers/

# Local configuration and secrets
config/

# Exported inverter history — large binaries, not source
data/

# Python
__pycache__/
*.py[cod]
.venv/
# Without the second form a .venv SYMLINK is not matched by the directory
# pattern above, and `git add -A` commits it. That happened once, from a
# git worktree pointed at the main checkout's environment.
.venv
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime
*.db
*.db-wal
*.db-shm

# OS
.DS_Store

