# systemd unit for Solar ArraySense.
#
# Install to /etc/systemd/system/arraysense.service and adjust User, Group and
# the two paths below to match where you cloned the source.
#
# The stop timeout matters more than it looks. The dongle accepts exactly one
# TCP client, and the service releases that slot during shutdown. Killing it
# before it finishes leaves the dongle occupied until it times the connection
# out on its own, which blocks both the next start and the vendor's app.

[Unit]
Description=Solar ArraySense
Documentation=https://github.com/sjordan0228/arraysense
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=arraysense
Group=arraysense
# A serial installation's USB-to-RS485 adapter is owned by the dialout group and
# is unreadable without it, even once it is visible. Harmless on a dongle
# installation, which opens no port and reaches the inverter over TCP.
SupplementaryGroups=dialout

WorkingDirectory=/opt/arraysense
ExecStart=/opt/arraysense/.venv/bin/python -m arraysense --config /etc/arraysense/config.toml

# To serve on port 80 instead, add --port 80 above and uncomment the line below.
# Ports under 1024 are privileged, and this service deliberately does not run as
# root; the capability grants that one binding and nothing else. Running the
# whole service as root to get a shorter URL is the wrong trade.
# AmbientCapabilities=CAP_NET_BIND_SERVICE

# SIGTERM lets the lifespan hook disconnect cleanly before the process exits.
KillSignal=SIGTERM
TimeoutStopSec=30

# An inverter that is unreachable is expected, not exceptional — the collector
# already backs off and retries on its own. Restarting covers the case where
# the process itself died. It is always, not on-failure, because the watchdog
# restarts a stalled loop by sending SIGTERM, and systemd treats a SIGTERM as a
# clean exit by default — on-failure would never restart after exactly the
# restart the watchdog exists to trigger.
Restart=always
RestartSec=10

# The database is the only thing this writes, and it needs no privileges beyond
# that. Everything else is closed off.
StateDirectory=arraysense
ConfigurationDirectory=arraysense
NoNewPrivileges=true
PrivateTmp=true
# false, not true, so a serial installation's USB-to-RS485 adapter — /dev/ttyUSB0
# or a udev symlink to it such as /dev/rs485 — is visible to the service. A
# private /dev holds only pseudo-devices (/dev/null, /dev/zero and the like), and
# the adapter is not among them: with PrivateDevices=true every serial poll failed
# with "could not open port ... No such file or directory" while the device
# plainly existed on the host, an error that points nowhere near the sandbox. A
# dongle-only installation opens no device and may set this back to true with a
# drop-in for the extra hardening; everything else in this sandbox is unaffected.
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Outbound to the dongle, inbound for the dashboard. Nothing else.
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
